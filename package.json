{
  "name": "@muyianking/ui",
  "type": "module",
  "version": "0.0.1-beta.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuyianKing/ui.git"
  },
  "keywords": [
    "MIT",
    "vue3",
    "ui",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "commit": "git add . && git cz",
    "dev": "vite --host --config playground/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "release": "node ./script/publish.js",
    "preview": "vite preview --config playground/vite.config.ts",
    "update-dep": "npm-check-updates & ncu -u & pnpm i",
    "log": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "prepare": "husky",
    "build": "node ./script/build.js"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@muyianking/utils": "^0.2.1",
    "@vueuse/core": "^15.0.0",
    "element-plus": "^2.14.7",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@muyianking/build": "^0.0.4",
    "@muyianking/components": "workspace:*",
    "@muyianking/config": "^0.0.8",
    "@muyianking/theme-chalk": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "inquirer": "^14.2.3",
    "lint-staged": "^17.6.0",
    "ora": "^9.4.1",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vue-tsc": "^3.3.12"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
