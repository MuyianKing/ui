{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force",
    "module": "ESNext",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@layout/*": [
        "./src/layout/*"
      ],
      "@views/*": [
        "./src/views/*"
      ],
      "@pinia/*": [
        "./src/pinia/modules/*"
      ],
      "@comp/*": [
        "./src/components/*"
      ],
      "@muyianking/ui": [
        "../packages/components/index.ts"
      ]
    },
    "types": [
      "vite/client",
      "element-plus/global",
      "unplugin-icons/types/vue"
    ],
    "allowImportingTsExtensions": true,
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  }
}
