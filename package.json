{
  "name": "@muyianking/ui",
  "type": "module",
  "version": "0.0.1-beta.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuyianKing/ui.git"
  },
  "keywords": [
    "MIT",
    "vue3",
    "ui",
    "typescript"
  ],
  "scripts": {
    "commit": "git add . && git cz",
    "dev": "vite --host --config test/vite.config.ts",
    "release": "node ./script/publish.js",
    "preview": "vite preview",
    "update-dep": "npm-check-updates & ncu -u & pnpm i",
    "log": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build": "node ./script/build.js"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@muyianking/utils": "^0.1.2",
    "@vueuse/core": "^12.8.2",
    "element-plus": "^2.14.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@muyianking/build": "^0.0.2",
    "@muyianking/components": "workspace:*",
    "@muyianking/config": "^0.0.8",
    "@muyianking/theme-chalk": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "cz-git": "^1.13.1",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "fs-extra": "^11.3.5",
    "inquirer": "^12.11.1",
    "lint-staged": "^15.5.2",
    "ora": "^8.2.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^2.2.12"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
